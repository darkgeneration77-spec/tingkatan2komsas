{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f2-komsas-2026",
  "main": "worker-d1.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tingkatan2komsas-db",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ]
}